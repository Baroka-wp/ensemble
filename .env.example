# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/influence_resto

# JWT (≥ 32 caractères en prod)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# App
NODE_ENV=development
PORT=3000
APP_DOMAIN=http://localhost:5173

# Bornes config (optionnelles)
DISCOUNT_MIN=5
DISCOUNT_MAX=50
REWARD_MAX_CENTS=10000
