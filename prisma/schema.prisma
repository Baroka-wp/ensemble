// Modèle v3 : influenceurs autonomes + collaborations restaurant ↔ influenceur.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collaborations Collaboration[]
  scans          Scan[]
  deviceBlocks   DeviceBlock[]
  reviews        Review[]

  @@map("restaurants")
}

model Influencer {
  id           String   @id @default(uuid()) @db.Uuid
  displayName  String   @map("display_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collaborations Collaboration[]

  @@map("influencers")
}

// Statut d'une collaboration influenceur ↔ restaurant.
//   pending          : demande envoyée, en attente de décision du restaurant
//   active           : acceptée, le code est utilisable au scan
//   rejected         : refusée par le restaurant
//   paused_by_inf    : mise en pause par l'influenceur (peut être réactivée par lui)
//   paused_by_resto  : mise en pause par le restaurant (peut être réactivée par lui)
enum CollaborationStatus {
  pending
  active
  rejected
  paused_by_inf   @map("paused_by_inf")
  paused_by_resto @map("paused_by_resto")

  @@map("collaboration_status")
}

model Collaboration {
  id           String   @id @default(uuid()) @db.Uuid
  influencerId String   @map("influencer_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid

  // Code promo unique par restaurant, modifiable par l'influenceur quand la collab est active.
  code String

  // Paramètres fixés par le restaurant (à l'acceptation ou via PATCH ultérieur).
  // Optionnels tant que la demande est pending — renseignés au moment du accept.
  discountPercent  Int? @map("discount_percent")
  rewardPerScanXof Int? @map("reward_per_scan_xof")

  status      CollaborationStatus @default(pending)
  requestedAt DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt   DateTime?           @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scans      Scan[]

  // Un influenceur ne peut avoir qu'UNE collaboration (de n'importe quel statut) avec un même resto.
  // Pour redemander après un reject, le resto doit d'abord supprimer ou l'influenceur réactiver.
  @@unique([influencerId, restaurantId], name: "uniq_collaboration_pair")
  // Le code reste unique par restaurant (côté scan, on cherche par slug + code).
  @@unique([restaurantId, code], name: "uniq_collaboration_code_per_restaurant")
  @@index([influencerId])
  @@index([restaurantId, status])
  @@map("collaborations")
}

model Scan {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  collaborationId String   @map("collaboration_id") @db.Uuid
  fingerprintHash String   @map("fingerprint_hash")
  // Snapshot du gain et de la réduction au moment T (jamais recalculés).
  rewardXof       Int      @map("reward_xof")
  discountPercent Int      @map("discount_percent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  ticket        Ticket?
  review        Review?

  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([collaborationId, createdAt(sort: Desc)])
  @@map("scans")
}

model Ticket {
  id         String   @id @default(uuid()) @db.Uuid
  scanId     String   @unique @map("scan_id") @db.Uuid
  ticketCode String   @unique @map("ticket_code")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model DeviceBlock {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  fingerprintHash String   @map("fingerprint_hash")
  blockedUntil    DateTime @map("blocked_until") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, fingerprintHash], name: "uniq_device_block")
  @@index([restaurantId, fingerprintHash, blockedUntil])
  @@map("device_blocks")
}

// Avis d'un client.
//   - Un avis par device par restaurant : unique (restaurantId, fingerprintHash).
//   - scanId nullable : null = avis libre (client venu sans code influenceur).
//     L'unicité reste : Postgres autorise plusieurs NULL dans un UNIQUE.
//   - Notes 1-5 sur 3 critères (ambiance, goût, service), commentaire optionnel.
//   - hiddenAt : soft-delete par le restaurant en cas d'abus (l'avis reste comptabilisé en stats internes mais
//     n'apparaît plus en public, et le contenu du commentaire n'est plus affiché).
model Review {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  scanId          String?  @unique @map("scan_id") @db.Uuid
  fingerprintHash String   @map("fingerprint_hash")

  ratingAmbiance Int @map("rating_ambiance")
  ratingTaste    Int @map("rating_taste")
  ratingService  Int @map("rating_service")

  comment String? @db.Text

  hiddenAt  DateTime? @map("hidden_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scan       Scan?      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, fingerprintHash], name: "uniq_review_per_device")
  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("reviews")
}
